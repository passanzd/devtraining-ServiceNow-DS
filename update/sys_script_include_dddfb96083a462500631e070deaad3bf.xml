        <script><![CDATA[var NeedItUtils = Class.create();
NeedItUtils.prototype = {
    initialize: function() {
    },
	isDatePast: function(strDate){
		var rightNow = new GlideDateTime();
		var test = new GlideDateTime(strDate);

		if (test.before(rightNow)){
			return true;
		} else{
			return false;
		}
	},
	isDateToday: function(strDate){
		var now = new GlideDateTime();
		var testDate = new GlideDateTime(strDate);
		if(testDate.before(now) || testDate.getDate().equals(now.getDate())){
			return true;
		}else{
			return false;
		}
	},

    type: 'NeedItUtils'
};]]></script>
